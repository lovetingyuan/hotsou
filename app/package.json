{
  "name": "hotsou",
  "version": "1.0.0",
  "private": true,
  "description": "show u sth fake, clown, actor, stupid",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/prepare-android.js && expo start --android --go",
    "build:android": "zx scripts/build.mjs",
    "build:preview": "eas build --platform android --profile preview",
    "update:android": "eas update --branch production --platform android --environment production",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "lint": "oxlint --fix .",
    "check-unused": "knip",
    "type-check": "tsc --noEmit",
    "doctor": "npx -y expo-doctor@latest",
    "upgrade-expo": "npm i -g eas-cli && npm install expo && npx expo install --fix && npm run doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.9.0",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-atomic-store": "^0.0.8",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/react": "~19.2.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dotenv": "^16.4.7",
    "download-cli": "^1.1.1",
    "knip": "^5.80.0",
    "open": "^10.1.0",
    "semver": "^7.7.1",
    "zx": "^8.6.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-atomic-store"
        ]
      }
    }
  }
